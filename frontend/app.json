{
  "expo": {
    "name": "Scavvy",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.scavvyexplore.bpw9xv",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan the world to unlock missions",
        "NSPhotoLibraryUsageDescription": "Share photos to complete missions",
        "NSLocationWhenInUseUsageDescription": "Create adventures where you explore"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#FF8A00"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.scavvyexplore.bpw9xv",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF6E6"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Scan the world to unlock missions"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Share photos to complete missions"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Create adventures where you explore"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

# Origin of the Node API. The Expo app appends `/api`.
# Simulator / web: http://localhost:4000
# Android emulator: http://10.0.2.2:4000
# Physical device / Expo Go: http://YOUR_WIFI_IP:4000
#   Find it with: ipconfig getifaddr en0
# Leave empty in production builds to run fully offline with local mocks.
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
